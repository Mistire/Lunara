NODE_ENV=development
PORT=3001

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lunara_db

# JWT Configuration
JWT_SECRET=lunara_jwt_secret_key_change_in_production_2024
JWT_REFRESH_SECRET=lunara_jwt_refresh_secret_key_change_in_production_2024
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000
